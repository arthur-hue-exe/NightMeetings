# Banco de dados (PostgreSQL). Preencha com as credenciais reais apenas no ambiente
# de execução; nunca versione .env com segredos.
DATABASE_URL="postgresql://usuario:senha@host:5432/motormeetings?schema=public"
DIRECT_URL="postgresql://usuario:senha@host:5432/motormeetings?schema=public"

# URL pública do site (sem barra final). Obrigatória em produção.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Limite de tamanho por imagem enviada (MB)
MAX_UPLOAD_MB="5"

# Diretório persistente dos uploads (padrão: ./storage/uploads)
# UPLOAD_DIR="/caminho/persistente/uploads"

# Armazenamento de imagens em produção.
# - "local": grava em UPLOAD_DIR (VPS/container com volume persistente).
# - "vercel-blob": envia para o Vercel Blob (serverless).
# Sem STORAGE_DRIVER, usa Vercel Blob quando BLOB_READ_WRITE_TOKEN existir e
# "local" fora da Vercel. Na Vercel sem token, o upload responde 503.
# STORAGE_DRIVER="local"
# Injetado automaticamente pela Vercel ao conectar um Blob store. Nunca exponha no frontend.
# BLOB_READ_WRITE_TOKEN=""

# Web Push (VAPID). Gere as chaves com: npx web-push generate-vapid-keys
# A chave privada nunca deve ser exposta no frontend nem versionada.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="sua-chave-publica-vapid"
VAPID_PRIVATE_KEY="sua-chave-privada-vapid"
VAPID_SUBJECT="mailto:contato@seudominio.com.br"

# Segredo aleatório usado para hash de IP nas proteções antispam
FORUM_IP_SALT="troque-por-um-valor-aleatorio-longo"
