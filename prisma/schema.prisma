// MotorMeetings — schema principal
// SQLite em desenvolvimento; para PostgreSQL/Supabase troque provider e URL (ver README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             String            @default("USER")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           Event[]
  eventAttendances EventAttendance[]
  sessions         Session[]

  communities          Community[]
  globalMessages       GlobalMessage[]
  conversationMembers  ConversationMember[]
  privateMessages      PrivateMessage[]
  createdConversations Conversation[]       @relation("ConversationCreator")
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  cookieConsents       CookieConsent[]
  reportsCreated       Report[]             @relation("ReportReporter")
  reportsReviewed      Report[]             @relation("ReportReviewer")
  moderationLogs       ModerationLog[]
  forumBansCreated     ForumBan[]

  @@index([createdAt])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Event {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  description      String?
  category         String
  city             String
  // Datas e horários são gravados como texto local (YYYY-MM-DD / HH:mm) no fuso
  // America/Sao_Paulo, evitando deslocamento de um dia em conversões UTC.
  eventDate        String
  startTime        String
  endDate          String?
  meetingPoint     String
  departurePoint   String?
  departureTime    String?
  arrivalPoint     String?
  arrivalDate      String?
  arrivalTime      String?
  coverImageUrl    String?
  additionalInfo   String?
  rules            String?
  routeNotes       String?
  contactInstagram String?
  status           String            @default("ACTIVE")
  featured         Boolean           @default(false)
  notifiedAt       DateTime?
  userId           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  images           EventImage[]
  attendances      EventAttendance[]

  @@index([status, eventDate])
  @@index([city, category, status])
  @@index([userId, status])
  @@index([featured, status])
  @@index([createdAt])
}

model EventImage {
  id        String   @id @default(cuid())
  eventId   String
  imageUrl  String
  altText   String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Confirmação de presença: cancelar mantém o registro (cancelledAt) para que
// reconfirmar não crie duplicatas nem infle a contagem.
model EventAttendance {
  id          String    @id @default(cuid())
  eventId     String
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, cancelledAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Comunidade: grupos, fórum global, mensagens privadas, notificações e consentimento
// ---------------------------------------------------------------------------

model Community {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  emblemUrl         String
  whatsappInviteUrl String
  city              String?
  category          String
  status            String   @default("ACTIVE")
  creatorId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creator           User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status, category])
  @@index([status, city])
  @@index([creatorId, status])
  @@index([createdAt])
}

model AnonymousSession {
  id                String             @id
  nickname          String
  createdAt         DateTime           @default(now())
  lastSeenAt        DateTime           @default(now())
  messages          GlobalMessage[]
  pushSubscriptions PushSubscription[]
  cookieConsents    CookieConsent[]
  reports           Report[]           @relation("AnonymousReporter")
  forumBans         ForumBan[]

  @@index([lastSeenAt])
}

model GlobalMessage {
  id               String            @id @default(cuid())
  sessionId        String?
  userId           String?
  displayName      String
  content          String
  moderationStatus String            @default("VISIBLE")
  ipHash           String?
  createdAt        DateTime          @default(now())
  session          AnonymousSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([moderationStatus, createdAt])
  @@index([sessionId, createdAt])
  @@index([ipHash, createdAt])
}

model ForumBan {
  id          String           @id @default(cuid())
  sessionId   String
  reason      String
  expiresAt   DateTime
  createdById String
  createdAt   DateTime         @default(now())
  session     AnonymousSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
}

model Conversation {
  id          String               @id @default(cuid())
  type        String               @default("DIRECT")
  name        String?
  imageUrl    String?
  status      String               @default("ACTIVE")
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    PrivateMessage[]

  @@index([type, status])
  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model PrivateMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model PushSubscription {
  id                 String            @id @default(cuid())
  userId             String?
  anonymousSessionId String?
  endpoint           String            @unique
  p256dh             String
  auth               String
  userAgent          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonymousSessionId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  targetUrl String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model CookieConsent {
  id                 String            @id @default(cuid())
  userId             String?
  anonymousSessionId String?
  consentVersion     String
  necessary          Boolean           @default(true)
  preferences        Boolean           @default(false)
  analytics          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonymousSessionId])
  @@index([consentVersion])
}

model Report {
  id                String            @id @default(cuid())
  reporterId        String?
  reporterSessionId String?
  targetType        String
  targetId          String
  reason            String
  details           String?
  status            String            @default("PENDING")
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime          @default(now())
  reporter          User?             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterSession   AnonymousSession? @relation("AnonymousReporter", fields: [reporterSessionId], references: [id], onDelete: SetNull)
  reviewedBy        User?             @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  notes      String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
