{
  "name": "motormeetings",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de encontros, eventos e rolês de motociclistas em Goiânia e Aparecida de Goiânia.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "assets": "tsx scripts/generate-assets.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "test:e2e:social": "node tests/e2e-social.mjs",
    "test:e2e:rsvp": "node tests/e2e-rsvp.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.552.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.65.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "playwright": "^1.64.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
